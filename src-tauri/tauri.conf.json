{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZForceClose",
  "version": "0.1.0",
  "identifier": "dev.theholyonez.zforceclose",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZForceClose",
        "width": 720,
        "height": 480,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "visible": true
      },
      {
        "label": "overlay",
        "url": "index.html?overlay=1",
        "title": "ZForceClose Kill Mode",
        "width": 440,
        "height": 110,
        "x": 100,
        "y": 40,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "shadow": false,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "copyright": "© TheHolyOneZ",
    "category": "Utility",
    "shortDescription": "No-mercy window killer",
    "longDescription": "Force-kill any frozen window with a hotkey and a click."
  },
  "plugins": {}
}
